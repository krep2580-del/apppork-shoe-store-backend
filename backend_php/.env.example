APP_NAME="Shoe Store Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shoe_store
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# Payment & Transfer Settings (กรุณาระบุข้อมูลบัญชีร้านค้าจริง)
PAYMENT_HOLD_MINUTES=1440
PAYMENT_RETRY_MINUTES=720
PROMPTPAY_ID=YOUR_PROMPTPAY_ID_HERE
PAYEE_NAME="YOUR_SHOP_NAME_HERE"
BANK_NAME="YOUR_BANK_NAME_HERE"
BANK_ACCOUNT_NO="XXX-X-XXXXX-X"

# Admin Initial Credentials (สำหรับคำสั่ง php artisan admin:create)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_NAME="Store Administrator"

