rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if authenticated user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if authenticated user has 'admin' role in Firestore
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. PRODUCTS COLLECTION
    // - Everyone can read products (public catalog)
    // - Only admin users can create, update, or delete products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. ORDERS COLLECTION
    // - Customers can read/create/update their own orders (matching userId)
    // - Admin users can read, update, or write all orders
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. USERS COLLECTION
    // - Users can read and update their own profile document
    // - Admin users can read and write all user profiles
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
